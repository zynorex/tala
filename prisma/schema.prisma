// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User Model - Stores user account information
model User {
  id            String     @id @default(cuid())
  
  // OAuth & Authentication
  email         String?    @unique
  emailVerified DateTime?
  image         String?    // Google profile image
  
  // Wallet authentication
  walletAddress String?    @unique // Web3 wallet address
  walletVerified DateTime?
  
  // Profile
  name          String?    // From Google or manual entry
  username      String?    @unique
  displayName   String?
  bio           String?
  
  // Auth methods tracking
  authMethods   String[]   @default([""])  // ["google", "wallet"] or either
  
  // Account status
  role          String     @default("user") // "user", "admin"
  isActive      Boolean    @default(true)
  isBlocked     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Subscription / Billing
  plan            PlanTier   @default(FREE)
  planExpiresAt   DateTime?  // Null = lifetime or free tier
  razorpayContactId String?  // Razorpay customer ID for recurring billing

  // AI Chat Bot
  aiChatCount     Int        @default(0) // Rate limit for FREE users

  // Relations
  accounts      Account[]
  sessions      Session[]
  vaults        Vault[]
  activityLogs  ActivityLog[]
  apiKeys       ApiKey[]
  unlockEvents  UnlockEvent[] @relation("UnlockEventUser")
  sharedVaults  VaultShare[]  @relation("SharedVaults")
  payments      Payment[]
  subscriptions Subscription[]
  
  @@index([email])
  @@index([walletAddress])
  @@index([role])
  @@index([createdAt])
}

// NextAuth Account Model
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth Session Model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// NextAuth Verification Token Model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Share Permission Levels
enum SharePermission {
  VIEW_ONLY     // Can view file list and metadata only
  DOWNLOAD      // Can view and download files (requires vault password)
  FULL_ACCESS   // Full access including adding/removing files
}

// VaultShare Model - Sharing vaults with others
model VaultShare {
  id              String          @id @default(cuid())
  vaultId         String
  vault           Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  
  // Share recipient (optional - null means public link)
  sharedWithUserId String?
  sharedWithUser   User?          @relation("SharedVaults", fields: [sharedWithUserId], references: [id], onDelete: SetNull)
  
  // Share token for link-based sharing
  shareToken      String          @unique @default(cuid())
  
  // Permissions
  permission      SharePermission @default(VIEW_ONLY)
  
  // Security
  requiresPassword Boolean        @default(true) // Always require vault password for decrypt
  sharePassword    String?        // Optional additional share-specific password (hashed)
  
  // Expiration
  expiresAt       DateTime?       // Null means never expires
  maxAccessCount  Int?            // Null means unlimited
  accessCount     Int             @default(0)
  
  // Invitation details
  inviteEmail     String?         // Email to send invitation to
  inviteSent      Boolean         @default(false)
  
  // Status
  isActive        Boolean         @default(true)
  revokedAt       DateTime?
  revokedBy       String?
  
  // Audit
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastAccessedAt  DateTime?
  
  @@index([vaultId])
  @@index([shareToken])
  @@index([sharedWithUserId])
  @@index([isActive])
  @@index([expiresAt])
}

// Vault Model - Stores encrypted vault metadata
model Vault {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Vault metadata
  name          String
  description   String?
  
  // Encryption
  encryptedData String     // Base64 encrypted vault content
  keyHash       String     // SHA-256 hash of encryption key (for verification)
  fileHash      String     // SHA-256 hash of original file
  
  // File info
  fileName      String
  fileSize      Int        // Size in bytes
  mimeType      String?
  
  // Demo vault flag
  isDemo        Boolean    @default(false)
  demoExpiresAt DateTime?  // Demo vaults can expire after period
  
  // ⏰ TIME-LOCK MECHANISM (RIGID STATE MANAGEMENT)
  unlockTime    DateTime?  // Unix timestamp when vault becomes accessible
  lockStatus    String     @default("LOCKED")  // "LOCKED", "WAITING", "UNLOCKED", "EXPIRED", "VOIDED"
  
  // Blockchain verification
  blockchainTxHash  String?  // Smart contract transaction hash
  smartContractId   Int?     // Vault ID on smart contract
  lastBlockchainSync DateTime? // Last time we verified unlock status on-chain
  
  // Status
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  voidedAt      DateTime?  // Timestamp when vault was voided/deleted
  
  // Relations
  files         VaultFile[]
  activityLogs  ActivityLog[]
  unlockEvents  UnlockEvent[]
  shares        VaultShare[]
  
  @@index([userId])
  @@index([createdAt])
  @@index([isDemo])
  @@index([lockStatus])
  @@index([unlockTime])
}

// UnlockEvent Model - Audit trail for unlock attempts
model UnlockEvent {
  id              String     @id @default(cuid())
  vaultId         String
  vault           Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: SetNull, name: "UnlockEventUser")
  
  // Unlock attempt details
  status          String     // "PENDING", "SUCCESS", "FAILED", "LOCKED"
  failureReason   String?    // Why unlock failed if it did
  
  // Verification
  timeVerified    DateTime   // Time this unlock event was created
  blockTimestamp  BigInt?    // Block timestamp from blockchain
  
  createdAt       DateTime   @default(now())
  
  @@index([vaultId])
  @@index([userId])
  @@index([createdAt])
}

// VaultFile Model - Stores individual files in a vault
model VaultFile {
  id                    String     @id @default(cuid())
  vaultId               String
  vault                 Vault      @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  
  // File metadata
  fileName              String
  fileSizeBytes         Int
  mimeType              String?
  
  // Encryption & Storage
  fileHash              String     // SHA-256 hash of original file
  ipfsHash              String     // IPFS content hash (encrypted file)
  encryptionKeyHash     String     // SHA-256 hash of encryption key
  
  // Encryption metadata (stored as JSON in encryptedData or separate fields)
  encryptionIV          String?    // Initialization Vector (hex)
  encryptionSalt        String?    // Salt for key derivation (hex)
  encryptionAuthTag     String?    // GCM authentication tag (hex)
  
  // Audit
  uploadedBy            String
  uploadedAt            DateTime   @default(now())
  isActive              Boolean    @default(true)
  deletedAt             DateTime?
  deletedBy             String?
  
  @@index([vaultId])
  @@index([uploadedAt])
  @@index([isActive])
}

// ActivityLog Model - Tracks vault access and modifications
model ActivityLog {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  vaultId       String?
  vault         Vault?     @relation(fields: [vaultId], references: [id], onDelete: SetNull)
  
  // Action details
  action        String     // "VAULT_CREATED", "VAULT_UNLOCKED", "FILE_DOWNLOADED", "FILE_DECRYPTED", "UNLOCK_ATTEMPT_FAILED"
  description   String?
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime   @default(now())
  
  @@index([userId])
  @@index([vaultId])
  @@index([createdAt])
  @@index([action])
}

// ApiKey Model - For programmatic access
model ApiKey {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  keyHash       String     @unique // Hashed API key for storage
  
  isActive      Boolean    @default(true)
  lastUsedAt    DateTime?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  @@index([userId])
}

// ─────────────────────────────────────────────
// BILLING & PAYMENTS
// ─────────────────────────────────────────────

enum PlanTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  GOVERNMENT
}

enum PaymentStatus {
  CREATED     // Order created, awaiting payment
  AUTHORIZED  // Payment authorised (card payments)
  CAPTURED    // Payment successfully captured
  FAILED      // Payment failed
  REFUNDED    // Payment refunded (full)
  PARTIALLY_REFUNDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// Payment Model - records every Razorpay transaction
model Payment {
  id                  String         @id @default(cuid())
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Plan purchased
  planTier            PlanTier
  billingInterval     BillingInterval

  // Razorpay identifiers
  razorpayOrderId     String         @unique // order_xxx
  razorpayPaymentId   String?        @unique // pay_xxx (set on capture)
  razorpaySignature   String?        // Payment signature for audit

  // Amounts (in paise — INR smallest unit)
  amountPaise         Int            // Total charged
  currency            String         @default("INR")

  // Status
  status              PaymentStatus  @default(CREATED)
  failureReason       String?

  // Validity window this payment covers
  periodStart         DateTime?
  periodEnd           DateTime?

  // Metadata
  ipAddress           String?
  userAgent           String?
  notes               Json?          // Razorpay order notes

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@index([createdAt])
}

// Subscription Model - tracks recurring Razorpay subscriptions
model Subscription {
  id                      String          @id @default(cuid())
  userId                  String
  user                    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Plan
  planTier                PlanTier
  billingInterval         BillingInterval

  // Razorpay subscription identifiers
  razorpaySubscriptionId  String          @unique // sub_xxx
  razorpayPlanId          String          // Razorpay plan ID

  // Status (mirrors Razorpay subscription states)
  status                  String          @default("created") // created | authenticated | active | pending | halted | cancelled | completed | expired

  // Billing window
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelledAt             DateTime?
  cancelReason            String?

  // Amounts (paise)
  amountPaise             Int
  currency                String         @default("INR")

  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([userId])
  @@index([razorpaySubscriptionId])
  @@index([status])
}

// ─────────────────────────────────────────────
// ACCESS CONTROL — Invite-only login allowlist
// ─────────────────────────────────────────────

model AllowedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  note      String?  // Admin memo ("Beta tester", "Board member", etc.)
  addedBy   String   // Admin ID / identifier who granted access
  createdAt DateTime @default(now())

  @@index([email])
}
